{
  "name": "fractal-lite",
  "version": "0.1.0",
  "description": "Electron wrapper that runs fractal-app-lite (FastAPI backend + SvelteKit frontend)",
  "main": "out/main/index.js",
  "author": "BioVisionCenter (University of Zurich)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/fractal-analytics-platform/fractal-app-lite.git"
  },
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "build-components": "bash scripts/build-components.sh",
    "build-frontend": "bash scripts/build-frontend.sh",
    "build-backend": "bash scripts/build-backend.sh",
    "package": "npm run build && electron-builder",
    "full-build": "npm run build-components && npm run package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.4.0"
  }
}
