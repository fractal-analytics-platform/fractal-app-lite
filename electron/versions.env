# Pinned versions of the external components bundled in every app build.
# This is the single source of truth: it is sourced by scripts/*.sh and read
# by the GitHub workflows (build-electron.yml, release.yml).
#
# Plain KEY=value lines only (no quotes, no spaces), so the file is valid both
# as a bash script and as a GitHub Actions $GITHUB_OUTPUT file.

# pixi executable bundled next to the backend (scripts/fetch-pixi.sh), also
# used by the workflows to create the `build` environment.
PIXI_VERSION=v0.83.0

# fractal-web tag cloned for the fractal-components library
# (scripts/build-frontend.sh).
FRACTAL_WEB_REF=v1.30.0-a2
